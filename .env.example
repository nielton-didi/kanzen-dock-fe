# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Use the same Supabase project as the backend (kanzen-dock-be) — the URL and
# anon key can be copied from that repo's .env.local (SUPABASE_URL /
# SUPABASE_ANON_KEY), or from the Supabase dashboard under Settings > API.
# The anon key is safe to expose to the browser; never put the service role
# key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL - must include the /api prefix (see
# docs/BUG_TRACKING_APP_PLAN.md "Frontend Alignment Notes").
NEXT_PUBLIC_API_URL=http://localhost:3001/api
